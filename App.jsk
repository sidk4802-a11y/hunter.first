  accent: "#7C5CFC",
  accentSoft: "#9B7DFF",
  accentGlow: "rgba(124,92,252,0.18)",
  pink: "#FC5C8A",
  gold: "#F5C842",
  green: "#3DD68C",
  text: "#F0EFF8",
  muted: "#7A79A0",
  placeholder: "#2E2E40",
};

